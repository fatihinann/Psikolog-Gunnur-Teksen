# Database
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://neondb_owner:npg_HW59tlyXjpGK@ep-cool-dawn-aizrnpfd-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Admin Authentication
# Admin panel username
ADMIN_USERNAME="admin"

# Admin password hash (use: npm run hash-password "your_password")
# Generate with: node scripts/hash-password.js "your_password"
# This should be a bcrypt hash (60 characters) or base64 encoded bcrypt hash (80 characters)
ADMIN_PASSWORD_HASH="your_bcrypt_hashed_password_here"

# Redis/Upstash (Optional - for rate limiting and caching)
# If not provided, the app will use in-memory store
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_token_here"

# Application Environment
# Options: development, production, test
NODE_ENV="development"

# Next.js
# The port where the Next.js server will run (optional, defaults to 3000)
PORT=3000

# CORS Configuration (Optional)
# Comma-separated list of allowed origins for production
# ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
